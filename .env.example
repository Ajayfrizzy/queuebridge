# QueueBridge — Root environment example
# Copy this to .env and fill in your local values.
# Never commit .env files to source control.

# --- apps/api ---

# PostgreSQL connection string
# Local dev: QueueBridge's own container `queuebridge-pg` on port 55433 (docs/local-environment.md).
# Nothing loads this file automatically: `set -a; source .env; set +a` in each terminal.
# Generate secrets with `pnpm env:generate`; verify with `pnpm build && pnpm env:check`.
DATABASE_URL=postgres://postgres:password@localhost:55433/queuebridge

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-64-character-random-hex-string
# Optional: independent HMAC key for offline coordinator authority tokens (>= 32 chars).
# When unset, a key is derived from SESSION_SECRET.
# COORDINATOR_SIGNING_KEY=replace-with-at-least-32-random-characters

# AES-256 encryption key for visitor phone numbers — 32 bytes as hex
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_ENCRYPTION_KEY=replace-with-64-character-hex-key

# M5.1 ticket recovery: the recovery-key, grant and throttle secrets are HKDF-derived from
# CONTACT_ENCRYPTION_KEY above. When it is unset, self-service recovery is DISABLED (join
# returns no key and /tickets/recover answers 503); nothing falls back to a weaker secret.
# Recovery attempts per minute per source address (every attempt counts, malformed ones too)
# RECOVERY_RATE_LIMIT_MAX=10
# Interval (seconds) of the automatic no-show sweep run by the API. The feature is OFF for
# every service unless its policy enables it. 0 disables the sweep in this process.
# AUTO_MISS_SWEEP_SECONDS=15
# M5.3 device health (read by BOTH the API and the worker: keep the values identical).
# Server time only. Defaults: stale after 900 s, coordinator expiry warning 300 s, unreviewed
# conflicts after 900 s, evaluation every 30 s ("alerts are paused" after 3 missed intervals).
# DEVICE_STALE_AFTER_SECONDS=900
# COORDINATOR_EXPIRY_WARN_SECONDS=300
# CONFLICT_REVIEW_WARN_SECONDS=900
# HEALTH_EVALUATION_INTERVAL_SECONDS=30
# M5.4 Smart Turn Alerts — Web Push (optional; the in-app alert needs nothing).
# Generate a key pair with `pnpm env:generate --vapid`. The API needs only the PUBLIC key; the
# PRIVATE key and the subject belong to the worker (give the private key to the worker only in
# production). Missing or invalid keys disable push without stopping either process.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:replace-with-your-contact@your-organization.example
# Worker transport: web (default when VAPID is set) | sandbox (TEST-ONLY, sends nothing) | off
# PUSH_TRANSPORT=web
# Push time-to-live (API and worker, same value) and active devices per ticket (API)
# TURN_ALERT_TTL_SECONDS=120
# PUSH_MAX_SUBSCRIPTIONS_PER_TICKET=3
# Extra push-service hosts accepted for subscriptions (comma-separated), besides the browsers'
# PUSH_ENDPOINT_HOSTS=
# MQ.2 Ask Que: longest offline validity of restricted help, seconds (capped by the session; max 43200)
# QUE_OFFLINE_HELP_TTL_SECONDS=43200
# Audit checkpoint key (M4, ADR-012): HMAC-SHA256, >= 32 characters. The worker SIGNS
# checkpoints with it; the API needs the SAME id + key to VERIFY them (otherwise verification
# reports "incomplete", never "verified"). Without it the worker's checkpoint job is disabled.
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUDIT_SIGNING_KEY_ID=local-dev-key-v1
# AUDIT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Largest queue session one redacted audit export may hold; larger sessions are refused (413)
# and must be read through the paginated audit view — never exported truncated.
# AUDIT_EXPORT_MAX_EVENTS=50000

# Allowed browser origins (comma-separated): used for CORS and the CSRF Origin check
CORS_ORIGIN=http://localhost:5173

# Public origin of the web app — used to build visitor join links and invitation links
WEB_BASE_URL=http://localhost:5173

# Max requests per minute per IP on unauthenticated auth endpoints (login, signup, invitations)
AUTH_RATE_LIMIT_MAX=10

# Set to true only behind a trusted reverse proxy (honours X-Forwarded-For for rate limiting)
TRUST_PROXY=false

# Server port
PORT=3002

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- apps/web ---

# Leave empty to call the API same-origin (/api/v1/...), which the Vite dev/preview server
# proxies to API_PROXY_TARGET. Set only if the API is served from another origin.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://localhost:3002
VITE_APP_ENV=development

# --- apps/worker ---

WORKER_POLL_INTERVAL_MS=5000
# Upper bound of a `worker.js --once` run (it then exits with status 1); a stop signal ends it at once
# WORKER_ONCE_TIMEOUT_MS=120000
# Audit checkpoints (uses AUDIT_SIGNING_KEY_ID / AUDIT_SIGNING_KEY above): checkpoint a session
# once this many events are unanchored, or once the oldest unanchored event is this old.
AUDIT_CHECKPOINT_MIN_EVENTS=25
AUDIT_CHECKPOINT_MAX_AGE_MS=600000

# SMS provider: 'sandbox' for development; set to provider name when live provider configured
SMS_PROVIDER=sandbox
# SMS_API_KEY=your-provider-api-key

# USSD provider: 'sandbox' for development; set to provider name when live provider configured
USSD_PROVIDER=sandbox
# USSD_WEBHOOK_SECRET=your-webhook-hmac-secret

# --- Testing ---

# Used by pnpm test:db — must point to a separate test database
TEST_DATABASE_URL=postgres://postgres:password@localhost:55433/queuebridge_test
