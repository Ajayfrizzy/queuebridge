{
  "name": "@queuebridge/assist",
  "version": "0.0.0",
  "private": true,
  "description": "Ask Que deterministic core: route registry, capability gating, keyword search and answers — no I/O",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./kb/*": "./dist/kb/*"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/build-kb.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "kb:lock": "tsc --project tsconfig.json && node scripts/build-kb.mjs --update"
  },
  "dependencies": {
    "@queuebridge/contracts": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "vitest": "4.1.12"
  }
}
