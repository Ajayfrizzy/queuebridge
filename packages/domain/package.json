{
  "name": "@queuebridge/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Ticket state machine, fairness policy, routing, and wait-time algorithms — no DB dependency",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@queuebridge/contracts": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "vitest": "4.1.12"
  }
}
