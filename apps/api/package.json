{
  "name": "@queuebridge/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API server for QueueBridge",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "node --watch --experimental-vm-modules dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'src/**/*.db.test.ts'",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@node-rs/argon2": "2.2.2",
    "@queuebridge/channels": "workspace:*",
    "@queuebridge/contracts": "workspace:*",
    "@queuebridge/domain": "workspace:*",
    "fastify": "5.12.7",
    "postgres": "3.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "4.1.12",
    "pino-pretty": "13.0.0",
    "vitest": "4.1.12"
  }
}
