{
  "name": "@queuebridge/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API server for QueueBridge",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "node --watch --experimental-vm-modules dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run --exclude '**/*.db.test.ts'",
    "test:db": "vitest run --include '**/*.db.test.ts'",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "10.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@queuebridge/channels": "workspace:*",
    "@queuebridge/contracts": "workspace:*",
    "@queuebridge/domain": "workspace:*",
    "fastify": "5.2.1",
    "postgres": "3.4.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "vitest": "2.1.8"
  }
}
