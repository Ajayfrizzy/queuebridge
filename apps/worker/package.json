{
  "name": "@queuebridge/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Notification outbox worker, audit checkpoint jobs, coordinator token expiry",
  "type": "module",
  "main": "./dist/worker.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "node --watch dist/worker.js",
    "start": "node dist/worker.js",
    "test": "vitest run --exclude 'src/**/*.db.test.ts'",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@queuebridge/channels": "workspace:*",
    "@queuebridge/contracts": "workspace:*",
    "@queuebridge/domain": "workspace:*",
    "postgres": "3.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "4.1.12",
    "vitest": "4.1.12"
  }
}
